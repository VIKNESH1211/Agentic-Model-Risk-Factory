  "components": {
    "schemas": {
      "Decision": {
        "properties": {
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "comment": {
            "type": "string",
            "title": "Comment",
            "default": ""
          },
          "decided_by": {
            "type": "string",
            "title": "Decided By",
            "default": "Model Risk Officer"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "Decision"
      },
      "DriftReq": {
        "properties": {
          "feature_set": {
            "type": "string",
            "title": "Feature Set",
            "default": "mixed"
          },
          "severity": {
            "type": "number",
            "title": "Severity",
            "default": 0.6
          },
          "auto_approve": {
            "type": "boolean",
            "title": "Auto Approve",
            "default": true
          }
        },
        "type": "object",
        "title": "DriftReq"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
