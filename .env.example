# LLM provider: openai | groq | anthropic | offline. With OPENAI_API_KEY set, openai is used automatically.
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# optional: a cheaper model for agent steps (defaults to LLM_MODEL's family default)
LLM_FAST_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
# live | record | replay   (replay = use demo/llm_cache, fall back to offline drafter)
LLM_MODE=replay
MAX_RUN_COST=2.0
# auto | docker | reference   (reference = recorded R outputs, no Docker needed)
SANDBOX_MODE=auto
SANDBOX_IMAGE=mrf-rsandbox:latest
ALLOW_TAMPER_DEMO=true
# seconds between visible agent steps (0 = as fast as possible)
DEMO_PACE=0.35
MLFLOW_TRACKING_URI=
