# LLM: "offline" = deterministic drafters (no key). "groq" = Groq free tier. "anthropic" = Claude.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# live | record | replay   (replay = use demo/llm_cache, fall back to offline drafter)
LLM_MODE=replay
MAX_RUN_COST=2.0
# auto | docker | reference   (reference = recorded R outputs, no Docker needed)
SANDBOX_MODE=auto
SANDBOX_IMAGE=mrf-rsandbox:latest
ALLOW_TAMPER_DEMO=true
# seconds between visible agent steps (0 = as fast as possible)
DEMO_PACE=0.35
MLFLOW_TRACKING_URI=
