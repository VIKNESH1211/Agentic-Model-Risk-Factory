import durations from "../vo/durations.json";
import markersJson from "../public/clips/markers.json";
import { SHOTS, type Shot } from "../vo/script";

export const FPS = 30;
const PAD = 0.3; // breath after each line

type Markers = Record<string, { duration: number; marks: Record<string, number> }>;
const markers = markersJson as Markers;

export type Timed = Shot & {
  frames: number;
  voSec: number;
  start: number; // first frame in the film
  src?: { file: string; fromSec: number; rate: number }; // footage window
};

const TRACE_LIKE = new Set(["intake", "redraft", "doc", "redevelop", "validate", "diagnose"]);
// human-gate shots: if the footage must be trimmed, keep the end (the decision click)
const GATE_LIKE = new Set(["gate1", "approve2", "gate3", "accept", "deploy", "plans"]);

function markSec(clip: string, m: string | number | undefined, fallback: number): number {
  if (typeof m === "number") return m;
  const c = markers[clip];
  if (!c) return fallback;
  if (m === "end") return c.duration;
  if (m && c.marks[m] != null) return c.marks[m];
  return fallback;
}

export function buildTimeline(): { shots: Timed[]; total: number } {
  let start = 0;
  const shots = SHOTS.map((s) => {
    const voSec = (durations as any).shots[s.id] ?? 3;
    const sec = Math.max(voSec + PAD, s.minSec ?? 0);
    const frames = Math.ceil(sec * FPS);
    let src: Timed["src"];
    if (s.clip && markers[s.clip]) {
      const dur = markers[s.clip].duration;
      let a = Math.max(0, markSec(s.clip, s.from, 0));
      let b = Math.min(dur, markSec(s.clip, s.to, dur));
      if (b - a < 0.5) { a = 0; b = dur; }
      // squeeze long footage into the shot (traces up to 14×, UI interactions at most 2.4× so clicks stay readable)
      const cap = s.maxRate ?? (TRACE_LIKE.has(s.id) ? 2.6 : 2.4);
      const rate = Math.min(cap, Math.max(1, (b - a) / sec));
      // traces and gates: end on the decision; other pages: start where the action starts
      const fromSec = TRACE_LIKE.has(s.id) || GATE_LIKE.has(s.id) ? Math.max(a, b - sec * rate) : a;
      src = { file: `clips/${s.clip}.mp4`, fromSec, rate };
    }
    const t: Timed = { ...s, frames, voSec, start, src };
    start += frames;
    return t;
  });
  return { shots, total: start };
}
