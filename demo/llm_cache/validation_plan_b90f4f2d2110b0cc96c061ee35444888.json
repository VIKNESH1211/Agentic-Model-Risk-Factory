{
  "task": "validation_plan",
  "model": "gpt-4o-mini",
  "data": {
    "plan": {
      "checks": [
        {
          "id": "performance.gini_test",
          "title": "Discrimination (Gini) on test",
          "category": "performance",
          "metric": "gini",
          "params": {
            "target": "bad",
            "score": "score",
            "split": "test"
          },
          "expand": null,
          "threshold": {
            "op": "<",
            "amber": 0.4,
            "red": 0.25
          },
          "severity": "high",
          "rationale": "A model that cannot rank risk is unfit for decisions."
        },
        {
          "id": "performance.gini_oot",
          "title": "Discrimination (Gini) on oot",
          "category": "performance",
          "metric": "gini",
          "params": {
            "target": "bad",
            "score": "score",
            "split": "oot"
          },
          "expand": null,
          "threshold": {
            "op": "<",
            "amber": 0.4,
            "red": 0.25
          },
          "severity": "high",
          "rationale": "A model that cannot rank risk is unfit for decisions."
        },
        {
          "id": "calibration.ratio_holdout",
          "title": "Calibration (predicted \u00f7 observed)",
          "category": "calibration",
          "metric": "calibration_ratio",
          "params": {
            "target": "bad",
            "score": "score",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 1.2,
            "red": 1.5
          },
          "severity": "medium",
          "rationale": "Ensures the model's predicted probabilities align with observed outcomes."
        },
        {
          "id": "calibration.ratio_low",
          "title": "Calibration \u2014 under-prediction",
          "category": "calibration",
          "metric": "calibration_ratio",
          "params": {
            "target": "bad",
            "score": "score",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": "<",
            "amber": 0.8,
            "red": 0.6
          },
          "severity": "medium",
          "rationale": "Identifies potential under-prediction of default rates."
        },
        {
          "id": "stability.score_psi",
          "title": "Score stability train \u2192 oot (PSI)",
          "category": "stability",
          "metric": "psi",
          "params": {
            "col": "score",
            "base": "train",
            "comp": "oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 0.1,
            "red": 0.25
          },
          "severity": "medium",
          "rationale": "Monitors the stability of score distributions over time."
        },
        {
          "id": "stability.csi",
          "title": "Input stability train \u2192 oot (CSI)",
          "category": "stability",
          "metric": "psi",
          "params": {
            "base": "train",
            "comp": "oot"
          },
          "expand": "features",
          "threshold": {
            "op": ">",
            "amber": 0.1,
            "red": 0.25
          },
          "severity": "low",
          "rationale": "Assesses the stability of input features over time."
        },
        {
          "id": "fairness.di_ratio",
          "title": "Favourable-outcome parity across groups (disparate impact)",
          "category": "fairness",
          "metric": "di_ratio",
          "params": {
            "split": "all"
          },
          "expand": "groups",
          "threshold": {
            "op": "<",
            "amber": 0.8,
            "red": 0.6
          },
          "severity": "medium",
          "rationale": "Ensures equitable treatment across demographic groups."
        },
        {
          "id": "data_quality.missing",
          "title": "Rows with a missing model input",
          "category": "data_quality",
          "metric": "rate_true",
          "params": {
            "col": "missing_any",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 0.02,
            "red": 0.1
          },
          "severity": "medium",
          "rationale": "Monitors the prevalence of missing data in model inputs."
        },
        {
          "id": "policy.adverse_rate",
          "title": "Share of adverse decisions",
          "category": "policy",
          "metric": "rate_true",
          "params": {
            "col": "flag",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 0.3,
            "red": 0.4
          },
          "severity": "medium",
          "rationale": "Ensures the adverse decision rate remains within acceptable limits."
        },
        {
          "id": "policy.monotonicity",
          "title": "Monotonicity of score with respect to default",
          "category": "policy",
          "metric": "monotone_by",
          "params": {
            "col": "score",
            "by": "bad",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": "<",
            "amber": 1,
            "red": 1
          },
          "severity": "high",
          "rationale": "Ensures that higher scores consistently indicate lower risk."
        }
      ],
      "investigations": [
        "challenger",
        "slice_search",
        "stress_test"
      ]
    },
    "summary": "The validation plan for CR-001 focuses on key performance metrics such as Gini and calibration ratios, ensuring model discrimination and stability over time. It also addresses fairness and data quality, with specific thresholds reflecting industry standards for a robust credit risk scorecard."
  }
}