{
  "task": "monitoring_plan",
  "model": "gpt-4o-mini",
  "data": {
    "plan": {
      "kpis": [
        "adverse_rate",
        "ae_ratio",
        "error_rate",
        "latency_p95_ms",
        "mean_score",
        "no_decision_rate",
        "predicted_rate",
        "realized_rate",
        "rpm",
        "score_psi",
        "worst_csi"
      ],
      "rules": [
        {
          "id": "score_psi_amber",
          "kpi": "score_psi",
          "op": ">",
          "threshold": 0.1,
          "windows": 3,
          "severity": "amber",
          "action": "notify",
          "rationale": ""
        },
        {
          "id": "score_psi_red",
          "kpi": "score_psi",
          "op": ">",
          "threshold": 0.25,
          "windows": 3,
          "severity": "red",
          "action": "revalidate",
          "rationale": ""
        },
        {
          "id": "input_csi_red",
          "kpi": "worst_csi",
          "op": ">",
          "threshold": 0.25,
          "windows": 3,
          "severity": "red",
          "action": "revalidate",
          "rationale": ""
        },
        {
          "id": "errors",
          "kpi": "error_rate",
          "op": ">",
          "threshold": 0.01,
          "windows": 2,
          "severity": "amber",
          "action": "notify",
          "rationale": ""
        },
        {
          "id": "no_decision",
          "kpi": "no_decision_rate",
          "op": ">",
          "threshold": 0.02,
          "windows": 2,
          "severity": "amber",
          "action": "notify",
          "rationale": ""
        },
        {
          "id": "latency",
          "kpi": "latency_p95_ms",
          "op": ">",
          "threshold": 150.0,
          "windows": 3,
          "severity": "amber",
          "action": "notify",
          "rationale": ""
        },
        {
          "id": "ae_high",
          "kpi": "ae_ratio",
          "op": ">",
          "threshold": 1.25,
          "windows": 3,
          "severity": "red",
          "action": "revalidate",
          "rationale": ""
        },
        {
          "id": "ae_low",
          "kpi": "ae_ratio",
          "op": "<",
          "threshold": 0.8,
          "windows": 3,
          "severity": "red",
          "action": "revalidate",
          "rationale": ""
        }
      ],
      "panels": [
        {
          "id": "volume",
          "title": "Volume & latency",
          "kind": "area",
          "kpis": [
            "rpm",
            "latency_p95_ms"
          ],
          "unit": ""
        },
        {
          "id": "stability",
          "title": "Stability (PSI / CSI)",
          "kind": "line",
          "kpis": [
            "score_psi",
            "worst_csi"
          ],
          "unit": ""
        },
        {
          "id": "quality",
          "title": "Errors & no-decision",
          "kind": "bar",
          "kpis": [
            "error_rate",
            "no_decision_rate"
          ],
          "unit": ""
        },
        {
          "id": "decisions",
          "title": "Mean score & adverse rate",
          "kind": "line",
          "kpis": [
            "mean_score",
            "adverse_rate"
          ],
          "unit": ""
        },
        {
          "id": "outcomes",
          "title": "Actual vs expected",
          "kind": "line",
          "kpis": [
            "realized_rate",
            "predicted_rate",
            "ae_ratio"
          ],
          "unit": ""
        }
      ],
      "scenarios": [
        {
          "id": "cost_of_living_squeeze",
          "title": "Cost of Living Squeeze",
          "description": "Simulates an increase in claims due to economic pressures.",
          "transforms": [
            {
              "op": "scale",
              "column": "numclaims",
              "value": 1.2,
              "fraction": 0.5
            }
          ]
        },
        {
          "id": "fraud_pattern_change",
          "title": "Fraud Pattern Change",
          "description": "Simulates a shift in fraud patterns leading to increased claims.",
          "transforms": [
            {
              "op": "shift",
              "column": "numclaims",
              "value": 5,
              "fraction": 0.3
            }
          ]
        },
        {
          "id": "mix_shift_young_drivers",
          "title": "Mix Shift to Young Drivers",
          "description": "Simulates a shift in the customer base towards younger drivers.",
          "transforms": [
            {
              "op": "set_category",
              "column": "agecat",
              "value": "1.0",
              "fraction": 0.4
            }
          ]
        }
      ],
      "rpm": 240
    },
    "summary": "The monitoring plan for model PR-001 includes a comprehensive set of KPIs and alert rules to ensure timely detection of issues. It also incorporates plausible drift scenarios to assess model robustness under changing conditions."
  }
}