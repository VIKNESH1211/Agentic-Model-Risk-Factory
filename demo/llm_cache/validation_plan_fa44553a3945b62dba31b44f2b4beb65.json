{
  "task": "validation_plan",
  "model": "gpt-4o-mini",
  "data": {
    "plan": {
      "checks": [
        {
          "id": "performance.gini_test",
          "title": "Discrimination (Gini) on test",
          "category": "performance",
          "metric": "gini",
          "params": {
            "target": "Class",
            "score": "score",
            "split": "test"
          },
          "expand": null,
          "threshold": {
            "op": "<",
            "amber": 0.4,
            "red": 0.25
          },
          "severity": "high",
          "rationale": "A model that cannot rank risk is unfit for decisions."
        },
        {
          "id": "performance.gini_oot",
          "title": "Discrimination (Gini) on oot",
          "category": "performance",
          "metric": "gini",
          "params": {
            "target": "Class",
            "score": "score",
            "split": "oot"
          },
          "expand": null,
          "threshold": {
            "op": "<",
            "amber": 0.4,
            "red": 0.25
          },
          "severity": "high",
          "rationale": "A model that cannot rank risk is unfit for decisions."
        },
        {
          "id": "calibration.ratio_holdout",
          "title": "Calibration (predicted \u00f7 observed)",
          "category": "calibration",
          "metric": "calibration_ratio",
          "params": {
            "target": "Class",
            "score": "score",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 1.2,
            "red": 1.5
          },
          "severity": "medium",
          "rationale": "Ensures model predictions are aligned with observed outcomes."
        },
        {
          "id": "calibration.ratio_low",
          "title": "Calibration \u2014 under-prediction",
          "category": "calibration",
          "metric": "calibration_ratio",
          "params": {
            "target": "Class",
            "score": "score",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": "<",
            "amber": 0.8,
            "red": 0.6
          },
          "severity": "medium",
          "rationale": "Identifies potential under-prediction issues in the model."
        },
        {
          "id": "stability.score_psi",
          "title": "Score stability train \u2192 oot (PSI)",
          "category": "stability",
          "metric": "psi",
          "params": {
            "col": "score",
            "base": "train",
            "comp": "oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 0.1,
            "red": 0.25
          },
          "severity": "medium",
          "rationale": "Monitors the stability of the score distribution over time."
        },
        {
          "id": "stability.csi",
          "title": "Input stability train \u2192 oot (CSI)",
          "category": "stability",
          "metric": "psi",
          "params": {
            "base": "train",
            "comp": "oot"
          },
          "expand": "features",
          "threshold": {
            "op": ">",
            "amber": 0.1,
            "red": 0.25
          },
          "severity": "low",
          "rationale": "Assesses the stability of input features over time."
        },
        {
          "id": "data_quality.missing",
          "title": "Rows with a missing model input",
          "category": "data_quality",
          "metric": "rate_true",
          "params": {
            "col": "missing_any",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 0.02,
            "red": 0.1
          },
          "severity": "medium",
          "rationale": "Ensures data quality by monitoring missing inputs."
        },
        {
          "id": "policy.adverse_rate",
          "title": "Share of adverse decisions",
          "category": "policy",
          "metric": "rate_true",
          "params": {
            "col": "flag",
            "split": "all"
          },
          "expand": null,
          "threshold": null,
          "severity": "low",
          "rationale": "Context for the decision rule; no pass/fail."
        }
      ],
      "investigations": [
        "slice_search",
        "stress_test"
      ]
    },
    "summary": "The validation plan for model FR-001 includes checks for performance, calibration, stability, data quality, and policy adherence. Each check is designed to ensure the model's effectiveness and compliance with industry standards, addressing the findings from the policy check."
  }
}