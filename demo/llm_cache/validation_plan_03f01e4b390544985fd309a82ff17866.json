{
  "task": "validation_plan",
  "model": "gpt-4o-mini",
  "data": {
    "plan": {
      "checks": [
        {
          "id": "performance.gini_test",
          "title": "Discrimination (Gini) on test",
          "category": "performance",
          "metric": "gini",
          "params": {
            "target": "bad",
            "score": "score",
            "split": "test"
          },
          "expand": null,
          "threshold": {
            "op": "<",
            "amber": 0.4,
            "red": 0.25
          },
          "severity": "high",
          "rationale": "A model that cannot rank risk is unfit for decisions."
        },
        {
          "id": "performance.gini_oot",
          "title": "Discrimination (Gini) on oot",
          "category": "performance",
          "metric": "gini",
          "params": {
            "target": "bad",
            "score": "score",
            "split": "oot"
          },
          "expand": null,
          "threshold": {
            "op": "<",
            "amber": 0.4,
            "red": 0.25
          },
          "severity": "high",
          "rationale": "A model that cannot rank risk is unfit for decisions."
        },
        {
          "id": "calibration.ratio_holdout",
          "title": "Calibration (predicted \u00f7 observed)",
          "category": "calibration",
          "metric": "calibration_ratio",
          "params": {
            "target": "bad",
            "score": "score",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 1.2,
            "red": 1.5
          },
          "severity": "medium",
          "rationale": "Ensures model predictions are aligned with observed outcomes."
        },
        {
          "id": "calibration.ratio_low",
          "title": "Calibration \u2014 under-prediction",
          "category": "calibration",
          "metric": "calibration_ratio",
          "params": {
            "target": "bad",
            "score": "score",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": "<",
            "amber": 0.8,
            "red": 0.6
          },
          "severity": "medium",
          "rationale": "Identifies potential under-prediction of defaults."
        },
        {
          "id": "stability.score_psi",
          "title": "Score stability train \u2192 oot (PSI)",
          "category": "stability",
          "metric": "psi",
          "params": {
            "col": "score",
            "base": "train",
            "comp": "oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 0.1,
            "red": 0.25
          },
          "severity": "medium",
          "rationale": "Monitors score stability over time."
        },
        {
          "id": "stability.csi",
          "title": "Input stability train \u2192 oot (CSI)",
          "category": "stability",
          "metric": "psi",
          "params": {
            "base": "train",
            "comp": "oot"
          },
          "expand": "features",
          "threshold": {
            "op": ">",
            "amber": 0.1,
            "red": 0.25
          },
          "severity": "low",
          "rationale": "Ensures input features remain stable over time."
        },
        {
          "id": "fairness.di_ratio",
          "title": "Favourable-outcome parity across groups (disparate impact)",
          "category": "fairness",
          "metric": "di_ratio",
          "params": {
            "split": "all"
          },
          "expand": "groups",
          "threshold": {
            "op": "<",
            "amber": 0.8,
            "red": 0.6
          },
          "severity": "medium",
          "rationale": "Checks for fairness in approval rates across demographic groups."
        },
        {
          "id": "data_quality.missing",
          "title": "Rows with a missing model input",
          "category": "data_quality",
          "metric": "rate_true",
          "params": {
            "col": "missing_any",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 0.02,
            "red": 0.1
          },
          "severity": "medium",
          "rationale": "Monitors the quality of input data for model predictions."
        },
        {
          "id": "policy.adverse_rate",
          "title": "Share of adverse decisions",
          "category": "policy",
          "metric": "rate_true",
          "params": {
            "col": "flag",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 0.3,
            "red": 0.4
          },
          "severity": "medium",
          "rationale": "Ensures the rate of adverse decisions is within acceptable limits."
        },
        {
          "id": "policy.monotonicity",
          "title": "Monotonicity check on score",
          "category": "policy",
          "metric": "monotone_by",
          "params": {
            "col": "score",
            "by": "age_band",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": "<=",
            "amber": 0.5,
            "red": 0.0
          },
          "severity": "high",
          "rationale": "Checks that the score does not increase with higher risk."
        }
      ],
      "investigations": [
        "challenger",
        "slice_search",
        "stress_test"
      ]
    },
    "summary": "The validation plan for CR-001 Retail PD Scorecard includes checks across performance, calibration, stability, fairness, data quality, and policy adherence. Each check is designed to ensure the model meets industry standards and effectively manages risk in credit decisions."
  }
}