        {
          "ref": "//shared/riskdata/applications_today.csv",
          "asset": "applications_today.csv"
        }
      ],
      "harness": {
        "args": []
      },
      "upstream": [
        {
          "model_id": "CR-001",
          "via_asset": "cr001_scores.csv"
        }
      ],
      "deployable": false,
      "notes": []
    },
    "notes_for_reviewer": "Ensure the 'pd_band' group has 7 labels corresponding to its 6 bins."
  }
}