{
  "task": "validation_plan",
  "model": "gpt-4o-mini",
  "data": {
    "plan": {
      "checks": [
        {
          "id": "performance.gini_test",
          "title": "Discrimination (Gini) on test",
          "category": "performance",
          "metric": "gini",
          "params": {
            "target": "bad",
            "score": "score",
            "split": "test"
          },
          "expand": null,
          "threshold": {
            "op": "<",
            "amber": 0.4,
            "red": 0.25
          },
          "severity": "high",
          "rationale": "A model that cannot rank risk is unfit for decisions."
        },
        {
          "id": "performance.gini_oot",
          "title": "Discrimination (Gini) on oot",
          "category": "performance",
          "metric": "gini",
          "params": {
            "target": "bad",
            "score": "score",
            "split": "oot"
          },
          "expand": null,
          "threshold": {
            "op": "<",
            "amber": 0.4,
            "red": 0.25
          },
          "severity": "high",
          "rationale": "A model that cannot rank risk is unfit for decisions."
        },
        {
          "id": "calibration.ratio_holdout",
          "title": "Calibration (predicted \u00f7 observed)",
          "category": "calibration",
          "metric": "calibration_ratio",
          "params": {
            "target": "bad",
            "score": "score",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 1.2,
            "red": 1.5
          },
          "severity": "medium",
          "rationale": "Ensures predicted probabilities align with observed outcomes."
        },
        {
          "id": "calibration.ratio_low",
          "title": "Calibration \u2014 under-prediction",
          "category": "calibration",
          "metric": "calibration_ratio",
          "params": {
            "target": "bad",
            "score": "score",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": "<",
            "amber": 0.8,
            "red": 0.6
          },
          "severity": "medium",
          "rationale": "Checks for under-prediction of default rates."
        },
        {
          "id": "stability.score_psi",
          "title": "Score stability train \u2192 oot (PSI)",
          "category": "stability",
          "metric": "psi",
          "params": {
            "col": "score",
            "base": "train",
            "comp": "oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 0.1,
            "red": 0.25
          },
          "severity": "medium",
          "rationale": "Monitors score distribution stability over time."
        },
        {
          "id": "stability.csi",
          "title": "Input stability train \u2192 oot (CSI)",
          "category": "stability",
          "metric": "psi",
          "params": {
            "base": "train",
            "comp": "oot"
          },
          "expand": "features",
          "threshold": {
            "op": ">",
            "amber": 0.1,
            "red": 0.25
          },
          "severity": "low",
          "rationale": "Assesses stability of input features across time."
        },
        {
          "id": "fairness.di_ratio",
          "title": "Favourable-outcome parity across groups (disparate impact)",
          "category": "fairness",
          "metric": "di_ratio",
          "params": {
            "approve": "approve",
            "split": "all"
          },
          "expand": "groups",
          "threshold": {
            "op": "<",
            "amber": 0.8,
            "red": 0.6
          },
          "severity": "medium",
          "rationale": "Ensures equitable treatment across demographic groups."
        },
        {
          "id": "data_quality.missing",
          "title": "Rows with a missing model input",
          "category": "data_quality",
          "metric": "rate_true",
          "params": {
            "col": "missing_any",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 0.02,
            "red": 0.1
          },
          "severity": "medium",
          "rationale": "Monitors the quality of input data for completeness."
        },
        {
          "id": "policy.adverse_rate",
          "title": "Share of adverse decisions",
          "category": "policy",
          "metric": "rate_true",
          "params": {
            "col": "flag",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": ">",
            "amber": 0.3,
            "red": 0.5
          },
          "severity": "medium",
          "rationale": "Checks the rate of adverse decisions to ensure compliance."
        },
        {
          "id": "policy.monotonicity",
          "title": "Monotonicity of score with respect to bad rate",
          "category": "policy",
          "metric": "monotone_by",
          "params": {
            "col": "score",
            "by": "bad",
            "split": "test|oot"
          },
          "expand": null,
          "threshold": {
            "op": "<",
            "amber": 0.5,
            "red": 0.3
          },
          "severity": "high",
          "rationale": "Ensures that higher scores correlate with lower bad rates."
        }
      ],
      "investigations": [
        "challenger",
        "slice_search",
        "stress_test"
      ]
    },
    "summary": "The validation plan for CR-001 focuses on key performance metrics, calibration, stability, fairness, and data quality checks to ensure the model's robustness and compliance. It includes thresholds based on industry standards to categorize performance as pass, amber, or red."
  }
}